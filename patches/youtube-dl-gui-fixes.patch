+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn detects_playlist_from_underscore_type_with_empty_entries() {
+    // Trimmed real `yt-dlp -J --flat-playlist` output for an empty channel tab.
+    let json = r#"{
+      "id": "UCxxxxxxxxxxxxxxxxxxxxxx",
+      "title": "Empty Channel - Videos",
+      "_type": "playlist",
+      "entries": [],
+      "webpage_url": "https://www.youtube.com/@empty/videos",
+      "extractor": "youtube:tab",
+      "extractor_key": "YoutubeTab",
+      "playlist_count": 0
+    }"#;
+    let info: YtdlpInfo = serde_json::from_str(json).expect("valid json");
+    assert_eq!(info.type_.as_deref(), Some("playlist"));
+    assert!(matches!(detect_info_type(&info), InfoType::Playlist));
+  }
+}
